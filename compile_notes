# setup paths for the gfortran compiler via the mesa sdk
# (required before compiling OR running anything built with this
# compiler -- without it, compiled executables/modules can fail to find
# libgfortran.dylib at runtime)

export MESASDK_ROOT=/Applications/mesasdk
source $MESASDK_ROOT/bin/mesasdk_init.sh


# compile the code in fortran alone, producing a standalone "rotwind"
# executable. note: there is currently no program/main driver in this
# directory (rotwind is a subroutine meant to be called from Python via
# f2py) -- add one before using this if you want a standalone binary.
gfortran -O3 -o rotwind *.f90

# compile with f2py into the "pyrotwind" python module.
#
# bsstep_mod.f90's bs_extrapolate takes dummy PROCEDURE arguments (the
# generic Bulirsch-Stoer retry/extrapolation engine shared by int1zone/
# int2zone/int3zone -- see that file's header), which f2py's wrapper
# generator cannot handle: it mis-parses the argument list and emits
# broken C (an undeclared 'nv' in the generated wrapper). bs_extrapolate
# is only ever called from Fortran (never from Python), so this is fine
# to skip explicitly with f2py's "skip:" clause -- everything else is
# still scanned/wrapped normally. bsstep_mod.f90 must be listed by name
# (not swept up in *.f90) so the skip: clause applies to it specifically.
f2py -c --fcompiler=gfortran --opt='-O3' -m pyrotwind \
  bsstep_mod.f90 skip: bs_extrapolate : \
  const.f90 params.f90 splinc.f90 ratext.f90 setup.f90 \
  int1zone.f90 int2zone.f90 int3zone.f90 \
  solidevol.f90 drevol.f90 threezoneevol.f90 rotwind.f90

# --- namelist input + one-track-per-call interface (2026) ---
# pyrotwind processes a single stellar track per call to rotwind, and
# configuration is read once up front rather than on every call:
#
#   1) constm.init_const(nml_file) and params.read_wind_params(nml_file)
#      are public module subroutines, callable directly from Python.
#      Call each once, before any calls to rotwind. See
#      rotwind_example.nml for the const and wind_params namelist
#      groups they expect, and const.f90/params.f90/setup.f90 for what
#      each entry means. This also sets pdisk/tlock (disk-locked
#      rotation period and disk lifetime), applied to every track.
#   2) rotwind itself no longer takes a namelist file argument, or
#      pdisk/tlock -- it just runs the integration for one track's
#      arrays. taucouple is a per-model array (same length as sage/si/
#      etc.), so the core-envelope coupling timescale can vary along
#      the track rather than being a single constant per track.
#
# example call from Python after building the module above:
#
#   import pyrotwind
#   pyrotwind.constm.init_const('rotwind_example.nml')
#   pyrotwind.params.read_wind_params('rotwind_example.nml')
#
#   for track in tracks:
#       swe, swc, swcore, sj, sje, sjc, sjcore, sprot, faccen, iermsg = \
#           pyrotwind.rotwind(
#               track.taucouple,   # array, same length as track.sage
#               track.taucouplecm, # array; only matters if lthreezone=.true.
#               track.sage, track.sl, track.sr, track.steffl, track.smcz,
#               track.srcz, track.sxc, track.si, track.sie, track.sic,
#               track.sicore,      # he core inertia; all-zero if no 3-zone
#               track.staucz, track.shec, track.sp, track.sm, track.nm)
#
# --- three-zone (core/middle/envelope) mode (2026) ---
# set lthreezone=.true. in the wind_params namelist group to evolve a
# growing helium core as a third zone (threezoneevol/int3zone), chained
# core-middle-envelope with two independent coupling timescales
# (taucouple for middle-envelope, taucouplecm for core-middle) and two
# independent mass-transfer boundaries (fcz for middle-envelope, fcm for
# core-middle, both built by setup from sie/sicore respectively).
# threezoneevol also transparently handles tracks/points that have no
# core zone yet (sicore <= 0) via the same int1zone/int2zone machinery
# drevol uses, so lthreezone=.true. is safe to use across a whole run of
# tracks even if only some of them ever grow a core. rotwind.f90's
# outputs swcore/sjcore are only meaningful in this mode; they come back
# as swcore=swc (corotating with the middle zone) and sjcore=0 otherwise.
#
# --- shared Bulirsch-Stoer engine (2026) ---
# int1zone/int2zone/int3zone used to each carry their own copy of the
# retry/extrapolation control flow (sub-step-count sequence, the
# ratext-driving loop, eps-based acceptance) around their own physics.
# That's now factored into bsstep_mod.f90's bs_extrapolate, called once
# per routine with the zone-specific physics passed in as two internal
# (host-associated) procedures -- see bsstep_mod.f90's header for the
# reset/substep contract, and int1zone.f90 for the simplest example.
# Behavior is unchanged: this was verified by diffing rotwind() output,
# to double precision, against the pre-refactor routines across several
# real MESA tracks spanning the solid-body, two-zone, and three-zone
# (including tracks that actually grow and evolve a helium core) paths.
